# Copy to .env only if you want to change defaults. Every value here is optional.
PORT=4114
# 1 forces replay mode (no login, no key, no model calls)
DEMO_REPLAY=
# live or replay; empty means live when a Claude Code login or ANTHROPIC_API_KEY is found
TRIAGE_MODE=
TRIAGE_MODEL=claude-sonnet-5-5
# Only needed when there is no local Claude Code login
ANTHROPIC_API_KEY=
TRIAGE_MAX_LIVE_RUNS_PER_DAY=40
TRIAGE_SPAN_DELAY_MS=1400
# Point at a triage service you run yourself instead of the one the API starts
AI_SERVICE_URL=
AI_RESTART_DELAY_MS=6000
DB_PATH=.data/pg
SEED_CLAIMS=20000
CURSOR_SECRET=change-me
KEY_PEPPER=change-me
DEMO_KEY_SEED=local-demo
DEMO_ENDPOINTS=1
