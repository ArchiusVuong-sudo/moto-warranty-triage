{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriageResult v1",
  "description": "Contract between the triage service and the claims API. Both sides validate against this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_cause", "evidence", "repair", "warranty", "summary"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1"] },
    "root_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "component", "confidence"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BATTERY_CELL_IMBALANCE",
            "INVERTER_OVERCURRENT",
            "COOLANT_PUMP_FAILURE",
            "CHARGE_PORT_WATER_INGRESS",
            "THROTTLE_CONNECTOR_INTERMITTENT",
            "FIRMWARE_BELOW_MINIMUM",
            "IMPACT_DAMAGE",
            "UNDETERMINED"
          ]
        },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "component": { "type": "string", "minLength": 2, "maxLength": 80 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "detail"],
        "properties": {
          "kind": { "type": "string", "enum": ["telemetry", "fault_code", "bulletin", "policy"] },
          "ref": { "type": "string", "minLength": 1, "maxLength": 60 },
          "detail": { "type": "string", "minLength": 3, "maxLength": 300 }
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts", "labour_hours"],
      "properties": {
        "parts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["part_number", "description", "qty"],
            "properties": {
              "part_number": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{4}$" },
              "description": { "type": "string", "minLength": 2, "maxLength": 80 },
              "qty": { "type": "integer", "minimum": 1, "maximum": 20 }
            }
          }
        },
        "labour_hours": { "type": "number", "minimum": 0, "maximum": 20 }
      }
    },
    "warranty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "clause", "reason"],
      "properties": {
        "decision": { "type": "string", "enum": ["covered", "not_covered", "needs_inspection"] },
        "clause": { "type": "string", "pattern": "^W[1-8]$" },
        "reason": { "type": "string", "minLength": 3, "maxLength": 300 }
      }
    },
    "summary": { "type": "string", "minLength": 10, "maxLength": 600 }
  }
}
